# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/school_assistant
# SQLite fallback (development)
# DATABASE_URL=sqlite+aiosqlite:///./school_assistant.db

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Telegram WebApp
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase (optional - for push notifications)
FIREBASE_CREDENTIALS=your_firebase_credentials_json_here

# SMS Provider (optional)
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-provider.com/send

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# School settings
DEFAULT_SCHOOL_START_TIME=08:00

# Super Admin
SUPER_ADMIN_PHONE=+998901234567
SUPER_ADMIN_TELEGRAM_ID=7916474913

# Web App URL (bot menyudagi Mini App manzili)
WEBAPP_URL=http://localhost:5173
